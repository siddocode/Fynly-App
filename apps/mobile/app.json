{
  "expo": {
    "name": "Fynly",
    "slug": "fynly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fynly",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fynly.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E14"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "473338a0-c336-4455-950c-6d22c85c468e"
      }
    },
    "owner": "mishrasid007"
  }
}
