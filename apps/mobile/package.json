{
  "name": "@fynly/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "ELECTRON_DISABLE_SANDBOX=1 expo start",
    "start:clear": "ELECTRON_DISABLE_SANDBOX=1 expo start -c",
    "android": "ELECTRON_DISABLE_SANDBOX=1 expo start --android",
    "ios": "ELECTRON_DISABLE_SANDBOX=1 expo start --ios",
    "web": "ELECTRON_DISABLE_SANDBOX=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "build": "expo export -p web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "^5.66.0",
    "expo": "58.0.20",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^0.475.0",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
